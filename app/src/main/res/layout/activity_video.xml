<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <FrameLayout
        android:id="@+id/videoBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- 双击左右区域跳转时闪一下的提示 -->
    <TextView
        android:id="@+id/tvSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/bg_toast"
        android:paddingLeft="18dp"
        android:paddingTop="9dp"
        android:paddingRight="18dp"
        android:paddingBottom="9dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <!-- 顶部信息 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingLeft="2dp"
        android:paddingRight="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_ripple"
            android:clickable="true"
            android:contentDescription="返回"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.012"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.02"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnRotate"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/bg_bar_pill"
            android:clickable="true"
            android:contentDescription="切换横竖屏"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingLeft="11dp"
            android:paddingRight="11dp"
            android:text="横屏"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="42dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_ripple"
            android:clickable="true"
            android:contentDescription="保存到本机"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            android:tint="#FFFFFFFF" />
    </LinearLayout>

    <!-- 底部控制 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="16dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <com.zhj.panxia.SeekLine
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ripple"
                android:clickable="true"
                android:contentDescription="上一个"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/btnRew"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ripple"
                android:clickable="true"
                android:contentDescription="后退十秒"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rew"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/btnPlay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_bar_pill"
                android:clickable="true"
                android:contentDescription="播放暂停"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/btnFf"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ripple"
                android:clickable="true"
                android:contentDescription="前进十秒"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ff"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ripple"
                android:clickable="true"
                android:contentDescription="下一个"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                android:tint="#FFFFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_bar_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="1.0×"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnAspect"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_bar_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="46dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="适应"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/buffer"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFFFF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:textColor="#FFFF8A8A"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:alpha="0"
        android:background="@drawable/bg_toast"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />
</FrameLayout>
