<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/olSurface"
        android:gravity="center_vertical"
        android:minHeight="@dimen/topbar_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/space_sm">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TitleText"
                android:text="@string/local_files" />

            <TextView
                android:id="@+id/tvSub"
                style="@style/SubText"
                android:text="" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSearch"
            style="@style/IconButton"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_search" />

        <ImageView
            android:id="@+id/btnRefresh"
            style="@style/IconButton"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/btnMore"
            style="@style/IconButton"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/olBorder" />

    <!-- 权限提示：未获得「所有文件访问」时显示，不影响私有目录里的正常操作 -->
    <LinearLayout
        android:id="@+id/bannerPerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_sm"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_error"
            android:tint="?attr/olDanger" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/local_perm_title"
                android:textColor="?attr/olText"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/tvPermHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/local_perm_hint"
                android:textColor="?attr/olDim"
                android:textSize="@dimen/text_meta" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnPermAction"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_state"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:text="@string/grant"
            android:textColor="?attr/olAccent"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <!-- 搜索（当前目录递归） -->
    <LinearLayout
        android:id="@+id/rowSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/local_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            tools:ignore="UnusedAttribute"
            android:inputType="text"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:singleLine="true"
            android:textColor="?attr/olText"
            android:textColorHint="?attr/olDim"
            android:textSize="@dimen/text_body" />

        <ImageView
            android:id="@+id/btnSearchClose"
            style="@style/IconButton"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            android:tint="?attr/olDim" />
    </LinearLayout>

    <!-- 多选操作栏：按钮可横向滚动，窄屏不挤压 -->
    <LinearLayout
        android:id="@+id/barSel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/olSurface2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_xs"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:text="@string/selected_none"
            android:textColor="?attr/olText"
            android:textSize="@dimen/text_label" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSelAll"
                    style="@style/SelButton"
                    android:text="@string/select_all" />

                <TextView
                    android:id="@+id/btnSelCopy"
                    style="@style/SelButton"
                    android:text="@string/copy_to_short" />

                <TextView
                    android:id="@+id/btnSelMove"
                    style="@style/SelButton"
                    android:text="@string/move_to_short" />

                <TextView
                    android:id="@+id/btnSelUpload"
                    style="@style/SelButton"
                    android:text="@string/upload_short" />

                <TextView
                    android:id="@+id/btnSelDel"
                    style="@style/SelButton"
                    android:text="@string/delete"
                    android:textColor="?attr/olDanger" />

                <TextView
                    android:id="@+id/btnSelCancel"
                    style="@style/SelButton"
                    android:text="@string/cancel"
                    android:textColor="?attr/olDim" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 面包屑 -->
    <HorizontalScrollView
        android:id="@+id/scrollCrumb"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/crumb"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md" />
    </HorizontalScrollView>

    <!-- 列表 / 状态 / 加载 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingStart="@dimen/space_sm"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivState"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.55"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_empty"
                android:tint="?attr/olDim" />

            <TextView
                android:id="@+id/tvStateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/empty_folder"
                android:textColor="?attr/olText"
                android:textSize="@dimen/text_row" />

            <TextView
                android:id="@+id/tvStateHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/empty_folder_hint"
                android:textColor="?attr/olDim"
                android:textSize="@dimen/text_meta" />

            <TextView
                android:id="@+id/btnStateAction"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_state_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="@dimen/space_xl"
                android:paddingEnd="@dimen/space_xl"
                android:text="@string/retry"
                android:textColor="?attr/olAccentText"
                android:textSize="@dimen/text_label"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/olBorder" />

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/olSurface"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:id="@+id/btnNewFolder"
            style="@style/BottomItem">
            <ImageView
                style="@style/BottomIcon"
                android:contentDescription="@string/new_folder"
                android:src="@drawable/ic_newfolder" />
            <TextView
                style="@style/BottomLabel"
                android:text="@string/new_folder_short" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNewFile"
            style="@style/BottomItem">
            <ImageView
                style="@style/BottomIcon"
                android:contentDescription="@string/new_file"
                android:src="@drawable/ic_newfile" />
            <TextView
                style="@style/BottomLabel"
                android:text="@string/new_file_short" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSort"
            style="@style/BottomItem">
            <ImageView
                style="@style/BottomIcon"
                android:contentDescription="@string/sort"
                android:src="@drawable/ic_sort" />
            <TextView
                style="@style/BottomLabel"
                android:text="@string/sort" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnTrash"
            style="@style/BottomItem">
            <ImageView
                style="@style/BottomIcon"
                android:contentDescription="@string/trash"
                android:src="@drawable/ic_trash" />
            <TextView
                style="@style/BottomLabel"
                android:text="@string/trash" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnCloud"
            style="@style/BottomItem">
            <ImageView
                style="@style/BottomIcon"
                android:contentDescription="@string/back_to_cloud"
                android:src="@drawable/ic_cloud" />
            <TextView
                style="@style/BottomLabel"
                android:text="@string/back_to_cloud_short" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
