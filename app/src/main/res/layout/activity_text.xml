<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/olBg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/olSurface"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:contentDescription="返回"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TitleText"
                android:text="" />

            <TextView
                android:id="@+id/tvSub"
                style="@style/SubText"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnFontMinus"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple"
            android:clickable="true"
            android:contentDescription="缩小字号"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="A-"
            android:textColor="?attr/olDim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnFontPlus"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple"
            android:clickable="true"
            android:contentDescription="放大字号"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="A+"
            android:textColor="?attr/olDim"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnEdit"
            style="@style/IconButton"
            android:contentDescription="编辑"
            android:src="@drawable/ic_edit" />

        <ImageView
            android:id="@+id/btnMore"
            style="@style/IconButton"
            android:contentDescription="更多"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/olBorder" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingRight="16dp"
            android:paddingBottom="44dp"
            android:textColor="?attr/olText"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </ScrollView>

    <EditText
        android:id="@+id/etBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:imeOptions="flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:lineSpacingExtra="4dp"
        android:overScrollMode="ifContentScrolls"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp"
        android:scrollbars="vertical"
        android:textColor="?attr/olText"
        android:textColorHint="?attr/olDim"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textColor="?attr/olDanger"
        android:textSize="13sp"
        android:visibility="gone" />

    <View
        android:id="@+id/divEdit"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/olBorder"
        android:visibility="gone" />

    <!-- 编辑态底部操作条 -->
    <LinearLayout
        android:id="@+id/barEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/olSurface"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnCancelEdit"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="取消"
            android:textColor="?attr/olText"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnSaveEdit"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="保存"
            android:textColor="?attr/olAccentText"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
