<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <!-- 顶部：返回 + 曲名 + 播放列表 -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="46dp"
                android:layout_marginLeft="-8dp"
                android:background="@drawable/bg_ripple"
                android:clickable="true"
                android:contentDescription="返回"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.012"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.02"
                    android:singleLine="true"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnList"
                android:layout_width="42dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_ripple"
                android:clickable="true"
                android:contentDescription="播放列表"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_list"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <!-- 封面 -->
        <FrameLayout
            android:id="@+id/cover"
            android:layout_width="192dp"
            android:layout_height="192dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/cover_bg">

            <TextView
                android:id="@+id/tvInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#33FFFFFF"
                android:textSize="86sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|right"
                android:layout_margin="14dp"
                android:alpha="0.4"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_music"
                android:tint="#FFFFFFFF" />
        </FrameLayout>

        <!-- 歌词 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/lyricsBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <TextView
                    android:id="@+id/ly0"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#59FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ly1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#99FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/ly2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.5"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#FF35D0BA"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ly3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#99FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/ly4"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#59FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoLyric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="暂无歌词\n把同名 .lrc 放到音频所在目录，或让它联网找"
                android:textColor="#66FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="right"
            android:singleLine="true"
            android:textColor="#59FFFFFF"
            android:textSize="11sp" />

        <!-- 进度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <com.zhj.panxia.SeekLine
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnLoop"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_bar_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="列表循环"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_ripple"
                android:clickable="true"
                android:contentDescription="上一首"
                android:focusable="true"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/btnPlay"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_bar_pill"
                android:clickable="true"
                android:contentDescription="播放暂停"
                android:focusable="true"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_ripple"
                android:clickable="true"
                android:contentDescription="下一首"
                android:focusable="true"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                android:tint="#FFFFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnSave"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_ripple"
                android:clickable="true"
                android:contentDescription="保存到本机"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_download"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_ripple"
                android:clickable="true"
                android:contentDescription="更多"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more"
                android:tint="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
